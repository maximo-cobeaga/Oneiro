character Fox {
  rig: library.rigs.biped_cutout
  build {
    head:  library.heads.round
    eyes:  library.eyes.dots
    mouth: library.mouths.visemes_basic
    body:  library.bodies.kid { height: 1 }
  }
  parts {
    head { file: "library/parts/Fox/head.png", height: 0.396, pivot: (0.5, 0.96) }
    body { file: "library/parts/Fox/body.png", height: 0.403, pivot: (0.5, 0.97) }
    arm { file: "library/parts/Fox/arm.png", height: 0.369, pivot: (0.801, 0.05) }
    leg { file: "library/parts/Fox/leg.png", height: 0.281, pivot: (0.502, 0.04) }
    face { mode: none }
  }
  voice { provider: file, pitch: 180 }
  sheet {
    notes: "Cut from fox_illustration.png with the hybrid cutter."
  }
  styles { cutout_2d: auto }
}
