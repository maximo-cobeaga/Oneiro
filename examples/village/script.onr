oneiro 0.1
project "Village"
style default: cutout_2d

use character Marta
use character Blob
use set village

# An open 3D set: real houses, trees and hills (built from library props and `solids`), seen from any side.
scene 1 "Morning in the village" in village {
  time: day
  place Marta at village.start
  place Blob at village.bench facing village.well

  camera wide from south move dolly_in for 4s
  Marta walks_to village.well
  Marta (happy): "Good morning, Blob!"

  transition dissolve for 0.8s
  camera wide from north
  Marta walks_to village.door
  wait 1s

  transition wipe_left for 0.6s
  camera wide from east
  Blob walks_to village.road
  wait 1s
}
